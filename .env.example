# Supabase → Project Settings → Database → Connection string
# DATABASE_URL - "Transaction" pooler (порт 6543, режим pgbouncer) - используется приложением в рантайме
# Для Vercel в кінець DATABASE_URL додайте &connection_limit=1 (інакше serverless-функції вичерпають пул з'єднань)
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL  - "Session"/прямое подключение (порт 5432) - нужно Prisma только для migrate/seed
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# Базовый URL сайта (для метаданных, sitemap, абсолютных ссылок в письмах/чеках)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Админка ---
ADMIN_SESSION_SECRET="сгенерируйте: node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\""
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="сменить-на-надёжный-пароль"

# --- Supabase Storage (фото товаров в адмінці) ---
# Project Settings → API → Project URL / service_role key
SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=


# --- Оплата (src/lib/payment) ---
# Чи показувати на чекауті оплату карткою онлайн. "false" - приховати, лишиться тільки накладений платіж.
NEXT_PUBLIC_ONLINE_PAYMENT_ENABLED="true"
# Активний провайдер: LIQPAY або MONOBANK (дефолт - MONOBANK, зазвичай дешевший
# еквайринг; перевірте актуальні тарифи перед запуском).
PAYMENT_PROVIDER="MONOBANK"
# Monobank для бізнесу → Plata by mono → API (https://api.monobank.ua/)
MONOBANK_TOKEN=
# ПриватБанк, тариф LiqPay (https://www.liqpay.ua/documentation) - потрібні лише якщо PAYMENT_PROVIDER=LIQPAY
LIQPAY_PUBLIC_KEY=
LIQPAY_PRIVATE_KEY=
# Тестовий режим LiqPay: 1 - тестовий, порожньо - бойовий. У продакшені має бути порожньо.
LIQPAY_SANDBOX=

# --- Доставка (src/lib/delivery/nova-poshta.ts) ---
# Особистий кабінет Nova Poshta → Налаштування → API (безкоштовно)
NOVA_POSHTA_API_KEY=

# --- Telegram-сповіщення про нові замовлення (необов'язково) ---
# Токен бота, отримується у @BotFather
TELEGRAM_BOT_TOKEN=
# Ідентифікатор Telegram-групи клієнтки (від'ємне число, наприклад -1001234567890). Бота треба додати в групу.
TELEGRAM_CHAT_ID=

# --- Аналітика (підключати останнім, коли сайт наповнений реальним контентом) ---
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
